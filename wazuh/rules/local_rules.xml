!-- Local rules -->
<!-- Custom rule IDs must be between 100000 and 120000 -->

<group name="local,sshd,bruteforce,">

  <!-- Rule 1: 5 failed SSH passwords (existing user) from the same IP within 60 seconds -->
  <rule id="100100" level="10" frequency="5" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <description>Custom: SSH brute force - 5 failed logins from $(srcip) in 60s</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- Rule 2: 5 attempts with non-existent usernames from the same IP within 60 seconds -->
  <rule id="100101" level="10" frequency="5" timeframe="60">
    <if_matched_sid>5710</if_matched_sid>
    <same_srcip />
    <description>Custom: SSH brute force - 5 invalid-user attempts from $(srcip) in 60s</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- SSH authentication succeeded after five failed login attempts -->

  <rule id="100102" level="12" frequency="5" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <if_sid>5715</if_sid>
    <same_srcip />

    <description>
        SSH authentication succeeded after five failed login attempts
        from the same source IP within 60 seconds.
    </description>

    <mitre>
        <id>T1110.001</id>
        <id>T1078</id>
    </mitre>

    <group>authentication_success,brute_force,correlation,</group>
  </rule>

</group>
